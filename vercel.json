
{
  "rewrites": [
    {
      "source": "/booking",
      "destination": "/Ochilink-Booking-Dynamic.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
