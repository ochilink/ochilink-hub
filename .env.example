DATABASE_URL=
RATE_LIMIT_SECRET=
# Exactly 64 hexadecimal characters (32 random bytes); retain securely.
APP_ENCRYPTION_KEY=
# Canonical HTTPS website origin, no path/query. Use the test deployment while testing.
PUBLIC_SITE_URL=
RESEND_API_KEY=
MAIL_FROM=
# Optional private admin notification destination.
NOTIFICATION_EMAIL=
# Use a test-mode Stripe secret until live payment testing is approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Private Vercel Blob store read/write token for customer documents.
# Keep server-side only; never expose it in public HTML.
BLOB_READ_WRITE_TOKEN=
# Separate PUBLIC Vercel Blob store token for hosted HTML app previews.
# Keep the token server-side; only signed upload authorization reaches Admin.
PREVIEW_BLOB_READ_WRITE_TOKEN=
# Separate PUBLIC Vercel Blob store token for reusable app/media branding images.
# Keep the token server-side; only short-lived signed upload authorization reaches Admin.
MEDIA_BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Public Google Tag Manager container ID (example: GTM-XXXXXXX).
# Not a secret; GTM is loaded only after analytics consent.
GTM_CONTAINER_ID=
